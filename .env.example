# YouTube Hunter — ixtiyoriy kalitlar. Bu faylni ~/youtube-hunter/.env ga qo'ying va qiymatlarni yozing.
# HECH QACHON .env ni GitHub'ga yuklamang.

# YouTube Data API kaliti (trend tahlili tez va aniq bo'ladi). Bo'sh qolsa yt-dlp qidiruv ishlatiladi.
YT_API_KEY=

# Anthropic (Claude) API kaliti (avto rejimda lahza va matnlarni Claude tanlaydi). Bo'sh qolsa oddiy evristika.
ANTHROPIC_API_KEY=
